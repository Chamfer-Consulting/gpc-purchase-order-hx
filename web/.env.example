# Copy to web/.env.local for local dev. Production values go in Cloudflare Pages
# project settings. These are all public-safe (they ship in the built bundle).
# Prod: VITE_API_BASE = https://api.garfieldproduce.com  (see docs/REBUILD-SETUP.md §5/§5.1)

VITE_SUPABASE_URL=https://<ref>.supabase.co
# Supabase → Settings → API Keys. New model: the publishable key (sb_publishable_...).
# The legacy anon key still works until end of 2026 — set whichever you have.
VITE_SUPABASE_PUBLISHABLE_KEY=<sb_publishable_...>
# VITE_SUPABASE_ANON_KEY=<legacy anon key>
VITE_API_BASE=http://localhost:8000
