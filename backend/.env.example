# Backend env. Copy to backend/.env for local dev.
# Production values go in the Railway service's Variables tab (docs/REBUILD-SETUP.md §4).

# ── Required to boot ─────────────────────────────────────────────────────────
# Supabase Postgres — the TRANSACTION pooler (:6543) for the API. The pipeline
# scripts (run_cloud_extraction.py / run_qbo_sync.py) use the SESSION string
# (:5432) instead. See docs/REBUILD-SETUP.md §1.
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# Access-token verification. Set at least ONE of the two paths:
#  1. SUPABASE_URL — the API discovers the project's asymmetric JWT signing keys
#     at <url>/auth/v1/.well-known/jwks.json and verifies ES256/RS256 tokens
#     locally. This is Supabase's current model; key rotation needs no redeploy.
#  2. SUPABASE_JWT_SECRET — Supabase → Settings → API → JWT Keys → "Legacy JWT
#     Secret". Only needed while the project still signs HS256. Legacy anon/
#     service_role keys and the shared secret work until end of 2026.
SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_JWT_SECRET=<legacy JWT secret, if still on HS256>
# SUPABASE_JWKS_URL=            # override only if the JWKS lives somewhere non-default

# ── Required in production ───────────────────────────────────────────────────
# CORS: comma-separated frontend origins allowed to call the API.
# Prod: https://dashboard.garfieldproduce.com  (Cloudflare Pages custom domain)
ALLOWED_ORIGINS=http://localhost:5173
# Where the OAuth callbacks 302 the browser back to. Defaults to the first
# ALLOWED_ORIGINS entry if unset — set it explicitly in prod.
FRONTEND_BASE=http://localhost:5173

# ── Needed only for the Gmail / QuickBooks connect flows ─────────────────────
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
# Prod: https://api.garfieldproduce.com/auth/{gmail,qbo}/callback (Railway custom domain)
GMAIL_REDIRECT_URI=http://localhost:8000/auth/gmail/callback
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
QBO_REDIRECT_URI=http://localhost:8000/auth/qbo/callback
QBO_ENVIRONMENT=sandbox          # "production" against real QuickBooks data

# ── Optional ────────────────────────────────────────────────────────────────
# Backend key for Supabase Storage (document capture, §3.1). New model:
# SUPABASE_SECRET_KEY = sb_secret_...  ·  legacy: SUPABASE_SERVICE_KEY = service_role.
# Either is accepted; not needed for JWT verification.
SUPABASE_SECRET_KEY=<sb_secret_... or the legacy service_role key>
SUPABASE_JWT_AUD=authenticated             # Supabase default; only change if you customised it
OAUTH_STATE_SECRET=                        # HMAC for the OAuth state token; defaults to the JWT secret / DB URL
DB_POOL_MIN=1
DB_POOL_MAX=8
ENV=dev
# The API itself never calls Claude — ANTHROPIC_API_KEY belongs to the pipeline
# (GitHub Actions), not here. Set it only if a reused module path ends up needing it.
# ANTHROPIC_API_KEY=
