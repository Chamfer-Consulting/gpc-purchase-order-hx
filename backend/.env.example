# Copy to backend/.env for local dev. Production values go in `fly secrets set`.

# Supabase TRANSACTION pooler (:6543) — see docs/REBUILD-SETUP.md §1
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-us-east-1.pooler.supabase.com:6543/postgres
DB_POOL_MIN=1
DB_POOL_MAX=8

SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_SERVICE_KEY=<service_role key>
SUPABASE_JWT_SECRET=<JWT secret from Project Settings > API > JWT Settings>
SUPABASE_JWT_AUD=authenticated

ALLOWED_ORIGINS=http://localhost:5173

# Shared with the pipeline (needed by reused modules + OAuth callbacks)
ANTHROPIC_API_KEY=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://localhost:8000/auth/gmail/callback
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
QBO_REDIRECT_URI=http://localhost:8000/auth/qbo/callback
QBO_ENVIRONMENT=sandbox

ENV=dev
