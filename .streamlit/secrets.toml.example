# Copy this file to .streamlit/secrets.toml (gitignored) for local development.
# On Streamlit Community Cloud, set these same keys in the app's Settings > Secrets
# instead of committing a real secrets.toml.

dashboard_password = "choose-a-password"
database_url = "postgresql://user:pass@host/dbname?sslmode=require"

# QuickBooks Online (keys from developer.intuit.com — use the Development/sandbox
# pair with qbo_environment "sandbox", or the Production pair with "production";
# they are NOT interchangeable, and reconnecting is required after switching)
qbo_client_id = "..."
qbo_client_secret = "..."
qbo_redirect_uri = "http://localhost:8501/"
qbo_environment = "sandbox"  # or "production"

# Gmail (OAuth client — see GMAIL_SETUP.md for how to create one). Used by the
# cloud extraction pipeline's "Connect Gmail" flow; redirect_uri should match
# qbo_redirect_uri above exactly.
gmail_client_id = "...apps.googleusercontent.com"
gmail_client_secret = "..."
gmail_redirect_uri = "http://localhost:8501/"

# Google Drive (service account — see SETUP.md for how to create one and share the
# folder with it as a Viewer). A regular Drive folder, not a Shared Drive — grab its ID
# from the URL while viewing the folder. Paste the downloaded JSON key's fields as-is below.
gdrive_folder_id = "..."

[gdrive_service_account]
type = "service_account"
project_id = "..."
private_key_id = "..."
private_key = "..."
client_email = "..."
client_id = "..."
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = "..."
